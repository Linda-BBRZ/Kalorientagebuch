@model Kalorientagebuch.Viewmodels.EntryViewModel

<div>
    <h4>Eintrag bearbeiten</h4>
    <div class="row">
        <div class="col-md-4">
        </div>
    </div>
    <form method="post" enctype="multipart/form-data">
        <table>
            <tr>
                <td><label asp-for="Description">@Html.DisplayNameFor(model => model.Description)</label></td>
                <td><input asp-for="Description"><span asp-validation-for="Description" class="text-danger"></span></td>
            </tr>
            <tr>
                <td><label asp-for="CategoryId"></label></td>
                <td>
                    <select asp-for="CategoryId" class="form-control">
                        <option value="">-- Kategorie auswählen --</option>
                        @foreach (var category in (List<Category>)@ViewData["Categories"])
                        {
                            <option value="@category.Id">@category.Caption</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </td>
            </tr>
            <tr>
                <td><label asp-for="Date"></label></td>
                <td>
                    <input asp-for="Date" type="date" max="@DateTime.Now.ToString("yyyy-MM-dd")">
                    <span asp-validation-for="Date" class="text-danger"></span>
                </td>
            </tr>
            <tr>
                <td><label asp-for="CaloriesAmount"></label></td>
                <td>
                    <input asp-for="CaloriesAmount" type="number" step="0.01">
                    <span asp-validation-for="CaloriesAmount" class="text-danger"></span>
                </td>
            </tr>
        </table>
        <input type="hidden" asp-for="UserId" />
        <button type="submit" class="btn btn-primary">Änderungen speichern</button>
        <a asp-action="Index">Abbrechen</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
@model Kalorientagebuch.Viewmodels.IndexEntryViewModel

<style>
    td {
        background-color: transparent !important;
    }
</style>

<div>
    <h1>Einträge Übersicht</h1>

    @if (User.Identity.IsAuthenticated)
    {
        <div>
            <a class="btn btn-primary" asp-area="" asp-controller="Entry" asp-action="Create">+ Neuen Eintrag anlegen</a>
        </div>
    }
    else
    {
        <div>
            <a class="btn btn-primary disabled">Einloggen, um neue Einträge anzulegen</a>
        </div>
    }

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Date</th>
                <th>Description</th>
                <th>CaloriesAmount</th>
                <th>UserId</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var entry in Model.Entries)
            {
                <tr style="background-color:@entry.Color">
                    <td>@entry.Id</td>
                    <td>@entry.Date.ToString("yyyy-MM-dd")</td>
                    <td>@entry.Description</td>
                    <td>@entry.CaloriesAmount</td>
                    <td>@entry.UserId</td>
                    <td><a asp-action="Details" asp-route-id="@entry.Id">Details</a></td>
                    <td><a asp-action="Edit" asp-route-id="@entry.Id">Edit</a></td>
                    <td><a asp-action="Delete" asp-route-id="@entry.Id" onclick="return confirm('Are you sure you want to delete this enry?')">Delete</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

@model Kalorientagebuch.Models.Requests.EntryCreateRequest

<div>
    <h4 class="display-4">Eintrag anlegen</h4>
    <div class="row">
        <div class="col-md-4">
        </div>
    </div>
    <form method="post" asp-action="Create" asp-controller="Entry">
        <div>
            <label>Barcode:</label>
            <input type="text" asp-for="Barcode" value="@Model.Barcode" />
            <button class="btn btn-primary" type="submit">Suchen</button>
        </div>
        <table>
            <tr>
                <td><label asp-for="Description"></label></td>
                <td>
                    <input value="@Model.Description">
                    <span asp-validation-for="Description" class="text-danger"></span>
                </td>
            </tr>
            <tr>
                <td><label asp-for="CategoryId"></label></td>
                <td>
                    <select asp-for="CategoryId" class="form-control" asp-items="@Model.Categories">
                        <option value="">-- Kategorie auswählen --</option>
@*                         @foreach (var category in (List<Category>)@ViewData["Categories"])
                        {
                            <option value="@category.Id">@category.Caption</option>
                        } *@
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </td>
            </tr>
            <tr>
                <td><label asp-for="Date"></label></td>
                <td>
                    <input asp-for="Date" type="date" value="@Model.Date" max="@DateTime.Now.ToString("yyyy-MM-dd")">
                    <span asp-validation-for="Date" class="text-danger"></span>
                </td>
            </tr>
            <tr>
                <td><label asp-for="CaloriesAmount"></label></td>
                <td>
                    <input asp-for="CaloriesAmount" type="number" value="@Model.CaloriesAmount">
                    <span asp-validation-for="CaloriesAmount" class="text-danger"></span>
                </td>
            </tr>
        </table>
        <button type="submit" class="btn btn-primary" asp-action="Save">Eintrag anlegen</button>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
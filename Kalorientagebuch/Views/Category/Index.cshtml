@model Kalorientagebuch.Viewmodels.IndexCategoryViewModel

<div>
    <h1>Kategorien Übersicht</h1>
    <div>
        <a class="btn btn-primary" asp-area="" asp-controller="Category" asp-action="Create">+ Neue Kategorie anlegen</a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Caption</th>
                <th>Color</th>
                <th>Typ</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Categories)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Caption</td>
                    <td style="background:@item.Color">@item.Color</td>
                    <td>@item.CategoryTypeCaption</td>
                    <td><a asp-action="Details" asp-route-id="@item.Id">Details</a></td>
                    <td><a asp-action="Edit" asp-route-id="@item.Id">Edit</a></td>
                    <td><a asp-action="Delete" asp-route-id="@item.Id" onclick="return confirm('Are you sure you want to delete this category?')">Delete</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@model List<Kalorientagebuch.Viewmodels.CategoryViewModel>
@{
    ViewData["Kalorientagebuch Kategorien"] = "Category";
}

<div>
    <h1>Kategorien Übersicht</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Caption</th>
                <th>CategoryTypId</th>
                <th>CategoryTyp Caption</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Id</td>
                    <td>@category.Caption</td>
                    <td>@category.CategoryType?.Id</td>
                    <td>@category.CategoryType?.Caption</td>
                </tr>
            }
        </tbody>
    </table>
</div>

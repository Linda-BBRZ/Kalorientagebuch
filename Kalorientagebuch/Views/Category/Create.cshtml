@model Kalorientagebuch.Viewmodels.CategoryViewModel
@using Kalorientagebuch.Viewmodels

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Caption" class="control-label"></label>
                <input asp-for="Caption" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="Color" class="control-label"></label>
                <input type="color" asp-for="Color" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="CategoryTypeId" class="control-label"></label>
                <select asp-for="CategoryTypeId" class="form-control">
                    <option value="">-- Kategorie-Typ auswählen --</option>
                    @foreach (var categoryType in (List<CategoryTypViewModel>)@ViewData["CategoryTypes"])
                    {
                        <option value="@categoryType.Id">@categoryType.Caption</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <input type="submit" value="Erstellen" class="btn btn-primary" />
            </div>
        </form>
    </div>

</div>
<div>
    <a asp-action="Index">Abbrechen</a>
</div>
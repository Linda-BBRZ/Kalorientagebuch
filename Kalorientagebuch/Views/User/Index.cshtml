@model Kalorientagebuch.Viewmodels.IndexUserViewModel

<div>
    <h1 class="display-4">Nutzer Übersicht</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Picture</th>
                <th>Name</th>
                <th>Birthday</th>
                <th>Gender</th>
                <th>Weight</th>
                <th>Height</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Items)
            {
                <tr>
                    <td><img src="/User/Image/@user.Id" alt="Picture" style="max-width: 60px" /></td>
                    <td>@user.Name</td>
                    <td>@user.Birthday.ToString("yyyy-MM-dd")</td>
                    <td>@user.Gender</td>
                    <td>@user.Weight</td>
                    <td>@user.Height</td>
                    <td><a asp-action="Details" asp-route-id="@user.Id">Details</a></td>
                    <td><a asp-action="Edit" asp-route-id="@user.Id">Edit</a></td>
                    <td><a asp-action="Delete" asp-route-id="@user.Id" onclick="return confirm('Are you sure you want to delete this user?')">Delete</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}